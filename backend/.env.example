# Application Environment Variables
PROJECT_NAME="NLP-Based Semantic and Behavioral Impact Analysis of API Changes"
DEBUG=false
API_PREFIX=/api

# NLP & SentenceTransformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD_HIGH=0.88
SIMILARITY_THRESHOLD_DRIFT=0.75
SIMILARITY_THRESHOLD_BREAKING=0.60

# Database
DB_PATH=backend/data/analysis_history.db
